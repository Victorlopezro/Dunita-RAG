# ─────────────────────────────────────────────────────────────
# rag-rack — Variables de entorno
# Copia este archivo a .env y ajusta los valores según tu entorno
# ─────────────────────────────────────────────────────────────

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_rack

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings (SBERT)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=75

# RAG retrieval
TOP_K=5

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Streamlit)
FRONTEND_API_URL=http://api:8000
