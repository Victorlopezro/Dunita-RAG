# ─────────────────────────────────────────────────────────────
# rag-rack — Variables de entorno para Windows SIN Docker
# Copia este archivo a .env si no usas Docker:
#   copy .env.windows .env
# ─────────────────────────────────────────────────────────────

# Qdrant (local, sin Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_rack

# Ollama (local, sin Docker)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings (SBERT)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=75

# RAG retrieval
TOP_K=5

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Streamlit)
FRONTEND_API_URL=http://localhost:8000
